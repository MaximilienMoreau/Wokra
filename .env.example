NODE_ENV=development
DATABASE_URL=postgresql://proof:proof@localhost:5432/proof

# Generate with: openssl rand -base64 33
AUTH_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
# Optional in dev: leave empty to disable the "Continue with GitHub" button.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend (https://resend.com/api-keys) — for the magic link email.
# Optional in dev: leave empty and the magic link is logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Wokra <onboarding@wokra.dev>"

# Vercel Blob (https://vercel.com/docs/storage/vercel-blob) — for post image uploads.
# Optional in dev: leave empty and the image field is disabled in the post composer.
BLOB_READ_WRITE_TOKEN=
