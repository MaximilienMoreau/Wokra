generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ArtifactType {
  REPO
  PRODUCT
  CASE_STUDY
  CONTRIBUTION
}

enum VerificationMethod {
  GITHUB_REPO
  DNS_TXT
}

model User {
  id            String    @id @default(cuid())
  handle        String?   @unique
  // Nullable because the Email/magic-link provider never supplies a name
  // (unlike GitHub OAuth) — events.createUser in lib/auth.ts backfills it.
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Generated column (name + handle + bio), maintained by Postgres — see migration SQL.
  searchVector Unsupported("tsvector")?

  accounts Account[]
  sessions Session[]

  skills    UserSkill[]
  interests Interest[]
  artifacts Artifact[]

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")

  sentMessages     Message[] @relation("Sender")
  receivedMessages Message[] @relation("Receiver")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Skill {
  id   String @id @default(cuid())
  slug String @unique
  name String

  users     UserSkill[]
  interests Interest[]
}

model UserSkill {
  userId  String
  skillId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Interest {
  userId  String
  skillId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Artifact {
  id          String              @id @default(cuid())
  userId      String
  type        ArtifactType
  title       String
  description String
  url         String
  stack       String[]
  verified    Boolean             @default(false)
  verifiedVia VerificationMethod?
  verifiedAt  DateTime?
  // DNS TXT challenge in progress; cleared once verified.
  verificationToken String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Generated column (title + description + stack + type), maintained by Postgres — see migration SQL.
  searchVector Unsupported("tsvector")?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, readAt])
}
